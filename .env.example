# TerraFusion Valuator Pro — Environment Variables
# Copy this file to .env.local and fill in your values

# OpenAI API Key — required for AI Narrative Drafting Agent
OPENAI_API_KEY=sk-...

# Optional: Override the OpenAI base URL (e.g. for Azure OpenAI or proxy)
# OPENAI_BASE_URL=https://api.openai.com/v1

# ---------------------------------------------------------------------------
# OPTIONAL: Supabase (for persistent order management and run history)
# ---------------------------------------------------------------------------
# If not set, the app runs in in-memory mode (data is lost on server restart).
# Create a free project at: https://supabase.com
# Then run the SQL migration in lib/supabase.ts (SUPABASE_MIGRATION_SQL) in
# the Supabase SQL editor to create all required tables.
#
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ---------------------------------------------------------------------------
# OPTIONAL: Application Settings
# ---------------------------------------------------------------------------
# The URL where the app is deployed (used for absolute URLs in exports)
# NEXT_PUBLIC_APP_URL=https://your-app.vercel.app

# ---------------------------------------------------------------------------
# OPTIONAL: Supabase (for persistent order management and run history)
# ---------------------------------------------------------------------------
# If not set, the app runs in in-memory mode (data is lost on server restart).
# Create a free project at: https://supabase.com
# Then run the SQL migration in lib/supabase.ts (SUPABASE_MIGRATION_SQL) in
# the Supabase SQL editor to create all required tables.
#
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ---------------------------------------------------------------------------
# OPTIONAL: Application Settings
# ---------------------------------------------------------------------------
# The URL where the app is deployed (used for absolute URLs in exports)
# NEXT_PUBLIC_APP_URL=https://your-app.vercel.app

# ---------------------------------------------------------------------------
# TerraFusion AI Gateway — narrative provider (SOVEREIGN BY DESIGN)
# ---------------------------------------------------------------------------
# The app works with NO external AI. Narrative drafting goes through a
# TerraFusion-controlled provider; external providers are optional + explicit.
#   template    (DEFAULT) structured scaffold from the workfile, no external call
#   terrafusion TerraFusion sovereign endpoint (set TERRAFUSION_AI_ENDPOINT)
#   openai      optional fallback — OPENAI_API_KEY only required in THIS mode
#   disabled    no drafting; clear message, no crash
AI_PROVIDER=template
# TERRAFUSION_AI_ENDPOINT=https://ai.terrafusion.local/v1/narrative
# TERRAFUSION_AI_API_KEY=
# OPENAI_API_KEY is OPTIONAL — only used when AI_PROVIDER=openai (see above).
