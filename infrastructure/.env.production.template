# Production Environment Variables Template
# Copy this to .env.production and fill in the actual values

# Database Configuration
POSTGRES_USER=tfvps_prod
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD
POSTGRES_DB=tfvps_production
POSTGRES_PORT=5432

# Redis Configuration
REDIS_PASSWORD=CHANGE_ME_REDIS_PASSWORD
REDIS_PORT=6379

# Application Security
JWT_SECRET=CHANGE_ME_SUPER_STRONG_JWT_SECRET_AT_LEAST_32_CHARS
JWT_EXPIRY=86400

# API Configuration
API_PORT=8080
API_RATE_LIMIT=1000
API_REPLICAS=2
CORS_ORIGIN=https://yourdomain.com

# Service Ports
AUTH_PORT=8081
AI_PORT=8082
DATA_PORT=8083
FRONTEND_PORT=3000

# External Service URLs (for production)
NEXT_PUBLIC_API_URL=https://api.yourdomain.com
NEXT_PUBLIC_AUTH_URL=https://auth.yourdomain.com
NEXT_PUBLIC_AI_URL=https://ai.yourdomain.com

# Web Server Ports
HTTP_PORT=80
HTTPS_PORT=443

# AI Service Configuration
AI_MODEL_ENDPOINT=https://api.openai.com/v1
AI_API_KEY=CHANGE_ME_OPENAI_API_KEY
WORKFLOW_TIMEOUT=600

# OAuth Configuration
OAUTH_CLIENT_ID=your_oauth_client_id
OAUTH_CLIENT_SECRET=your_oauth_client_secret

# External Data APIs
EXTERNAL_DATA_API_KEY=your_data_api_key
DATA_SYNC_INTERVAL=3600

# Monitoring
PROMETHEUS_PORT=9090
GRAFANA_PORT=3001
GRAFANA_ADMIN_PASSWORD=CHANGE_ME_GRAFANA_PASSWORD

# Logging
RUST_LOG=info

# Data Storage Path
DATA_PATH=/opt/terrafusion/data

# SSL Configuration
SSL_CERT_PATH=/etc/nginx/ssl/cert.pem
SSL_KEY_PATH=/etc/nginx/ssl/private.key

# Backup Configuration
BACKUP_RETENTION_DAYS=30
BACKUP_SCHEDULE="0 2 * * *"

# Resource Limits
MAX_MEMORY_API=1G
MAX_MEMORY_AI=2G
MAX_MEMORY_DB=2G
MAX_CPU_API=1.0
MAX_CPU_AI=2.0

# Feature Flags
ENABLE_TELEMETRY=false
ENABLE_DEBUG_MODE=false
ENABLE_MAINTENANCE_MODE=false