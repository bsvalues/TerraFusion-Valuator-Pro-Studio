# Development Environment Variables Template
# Copy this to .env.development and fill in the actual values

# Database Configuration
POSTGRES_USER=tfvps
POSTGRES_PASSWORD=tfvps
POSTGRES_DB=tfvps
POSTGRES_PORT=5432

# Redis Configuration  
REDIS_PASSWORD=tfvps_redis
REDIS_PORT=6379

# Application Security
JWT_SECRET=development_jwt_secret_not_for_production
JWT_EXPIRY=86400

# API Configuration
API_PORT=8080
API_RATE_LIMIT=100
CORS_ORIGIN=http://localhost:3000

# Service Ports
AUTH_PORT=8081
AI_PORT=8082
DATA_PORT=8083
FRONTEND_PORT=3000

# External Service URLs (for development)
NEXT_PUBLIC_API_URL=http://localhost:8080
NEXT_PUBLIC_AUTH_URL=http://localhost:8081
NEXT_PUBLIC_AI_URL=http://localhost:8082

# AI Service Configuration
AI_MODEL_ENDPOINT=https://api.openai.com/v1
AI_API_KEY=your_openai_api_key_here
WORKFLOW_TIMEOUT=300

# OAuth Configuration (optional for dev)
OAUTH_CLIENT_ID=dev_oauth_client_id
OAUTH_CLIENT_SECRET=dev_oauth_client_secret

# External Data APIs
EXTERNAL_DATA_API_KEY=dev_data_api_key
DATA_SYNC_INTERVAL=1800

# Monitoring (optional in dev)
PROMETHEUS_PORT=9090
GRAFANA_PORT=3001
GRAFANA_ADMIN_PASSWORD=admin

# Logging
RUST_LOG=debug

# Data Storage Path
DATA_PATH=./data

# Feature Flags
ENABLE_TELEMETRY=true
ENABLE_DEBUG_MODE=true
ENABLE_MAINTENANCE_MODE=false